# Token from @BotFather
BOT_TOKEN=123456789:replace-me

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone. A blocked user is shown their ID to send you.
ALLOWED_USERS=

# Flights older than this many days are deleted automatically (checked hourly).
RETENTION_DAYS=3

# Optional: database file location (default: data.sqlite3 next to main.py)
DB_PATH=
